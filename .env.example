# ---- Mode -------------------------------------------------------------
# MOCK_MODE=true points every client at the bundled mock APIs (no keys, no network).
MOCK_MODE=true
MOCK_BASE_URL=http://127.0.0.1:8710
DATA_DIR=data
LOG_JSON=true

# ---- Gumroad -----------------------------------------------------------
# Settings -> Advanced -> Applications -> generate an access token
GUMROAD_ACCESS_TOKEN=
# Ping URL to paste in Gumroad: https://<host>/webhooks/gumroad?token=<GUMROAD_WEBHOOK_TOKEN>
GUMROAD_WEBHOOK_TOKEN=change-me-long-random

# ---- Shopify -----------------------------------------------------------
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2024-10
# App -> API credentials -> "API secret key" (used to verify X-Shopify-Hmac-Sha256)
SHOPIFY_WEBHOOK_SECRET=

# ---- Airtable ----------------------------------------------------------
# Personal access token with data.records:read + data.records:write on the base
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE=Orders
# Airtable allows 5 requests/second per base. Stay just under it.
AIRTABLE_MAX_RPS=4.5
# After a 429 Airtable asks you to wait 30 seconds (Retry-After is honoured if sent).
AIRTABLE_429_COOLDOWN=30

# ---- Reliability -------------------------------------------------------
RETRY_ATTEMPTS=4
RETRY_BASE_DELAY=1.0
HTTP_TIMEOUT=20
